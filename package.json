{
  "name": "tokenlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An interactive tokenizer visualiser for Greek. Watch what Greek costs you.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check && vite build",
    "preview": "vite preview",
    "measure": "tsx tools/measure.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsx tools/check-claims.ts"
  },
  "dependencies": {
    "gpt-tokenizer": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
