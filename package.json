{
  "name": "tokenlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An interactive page that shows what tokenizers do to Greek text, and what it costs. Type Greek, watch it shatter into tokens, watch the price update.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check && vite build",
    "preview": "vite preview",
    "measure": "tsx tools/measure.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:segments && npm run check:claims && npm run check:measurement && npm run check:prerender && npm run check:licences && npm run check:workflow",
    "capture": "node tools/capture.mjs",
    "check:claims": "tsx tools/check-claims.ts",
    "check:segments": "tsx tools/check-segments.ts",
    "check:loading": "node tools/check-loading.mjs",
    "verify": "node tools/verify.mjs",
    "check:measurement": "tsx tools/check-measurement.ts",
    "check:licences": "tsx tools/check-licences.ts",
    "check:workflow": "tsx tools/check-workflow.ts",
    "prerender": "tsx tools/prerender.ts",
    "check:prerender": "tsx tools/check-prerender.ts"
  },
  "dependencies": {
    "gpt-tokenizer": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "playwright": "1.61.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wait-on": "9.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "keywords": [
    "greek",
    "tokenizer",
    "bpe",
    "tiktoken",
    "typescript",
    "data-visualization",
    "llm",
    "nlp"
  ]
}
